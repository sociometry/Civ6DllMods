<?xml version="1.0" encoding="utf-8"?>
<Mod id="00000000-0000-0000-0000-000000000001"
     version="1">
    <Properties>
        <Name>Your DLL Mod</Name>
        <Description>Example DLL mod using Civ6DllLoader shell+runtime election.</Description>
        <Teaser>DLL mod sample</Teaser>
        <Authors>You</Authors>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
        <AffectsSavedGames>1</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
    </Dependencies>
    <FrontEndActions>
        <UpdateDatabase id="Config">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <File>Data/Config.sql</File>
        </UpdateDatabase>

        <!-- 主菜单界面：文件名必须以 FrontEndUI_ 开头、以 .xml 结尾；
             同名的 .lua 由 ForgeUI 按 base name 自动带出，不必在这里声明。
             整个 ImportFiles 块加 criteria 会导致块内所有声明都不加载，
             且 Criteria 元素必须排在 File 前面。详见 PLUGIN_GUIDE.md §7。 -->
        <ImportFiles id="FrontEndUI">
            <File>UI/FrontEnd/FrontEndUI_YourFeature.xml</File>
        </ImportFiles>
    </FrontEndActions>
    <Files>
        <File>Binaries/Win64/GameCore_XP2_Shell_FinalRelease.dll</File>
        <File>Binaries/Win64/Civ6DllLoader.runtime.dll</File>
        <File>Binaries/Win64/Plugins/Global/YourFeature.dll</File>
        <File>Data/Config.sql</File>
        <File>UI/FrontEnd/FrontEndUI_YourFeature.xml</File>
        <File>UI/FrontEnd/FrontEndUI_YourFeature.lua</File>
    </Files>
</Mod>
