<?xml version="1.0" encoding="utf-8"?>
<Mod id="b7e4c1a9-3f52-4d80-9e61-2a8c5d4f7b03" version="1">
    <Properties>
        <Name>Civ6 Base Plugin - GameCore</Name>
        <Description>Civ6DllLoader GameCore 插件：修原版缺陷、补 Lua 接口，并示范两个自定义 Requirement 与一个自定义 Effect。</Description>
        <Teaser>DLL: bug fixes, Lua APIs, custom requirements and effects</Teaser>
        <Authors>DllLoader Examples</Authors>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
        <AffectsSavedGames>1</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68"
             title="Expansion: Gathering Storm" />
    </Dependencies>
    <FrontEndActions>
        <UpdateDatabase id="Config">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <File>Data/Config.sql</File>
        </UpdateDatabase>
    </FrontEndActions>
    <InGameActions>
        <UpdateDatabase id="Gameplay">
            <Properties>
                <LoadOrder>200</LoadOrder>
            </Properties>
            <File>Data/Gameplay.sql</File>
        </UpdateDatabase>
        <ImportFiles id="EffectsScript">
            <File>Script/Effects.lua</File>
        </ImportFiles>
    </InGameActions>
    <Files>
        <File>Binaries/Win64/GameCore_XP2_Shell_FinalRelease.dll</File>
        <File>Binaries/Win64/Civ6DllLoader.runtime.dll</File>
        <File>Binaries/Win64/Plugins/GameCore/Civ6BasePlugin_GameCore.dll</File>
        <File>Data/Config.sql</File>
        <File>Data/Gameplay.sql</File>
        <File>Script/Effects.lua</File>
    </Files>
</Mod>