<?xml version="1.0" encoding="utf-8"?>
<Mod id="aa268bf6-96c6-4de6-a2b8-868c7cc62286"
     version="1">
    <Properties>
        <Name>New Requirements</Name>
        <Description>Injects custom GameEffects requirements via Civ6DllLoader.</Description>
        <Teaser>DLL: custom player and plot requirements</Teaser>
        <Authors>DllLoader Examples</Authors>
        <CompatibleVersions>1.2,2.0</CompatibleVersions>
        <AffectsSavedGames>1</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68"
             title="Expansion: Gathering Storm" />
    </Dependencies>
    <FrontEndActions>
        <UpdateDatabase id="Config">
            <Properties>
                <LoadOrder>100</LoadOrder>
            </Properties>
            <File>Data/Config.sql</File>
        </UpdateDatabase>
    </FrontEndActions>
    <InGameActions>
        <UpdateDatabase id="Requirements">
            <Properties>
                <LoadOrder>200</LoadOrder>
            </Properties>
            <File>Data/Requirements.sql</File>
        </UpdateDatabase>
    </InGameActions>
    <Files>
        <File>Binaries/Win64/GameCore_XP2_Shell_FinalRelease.dll</File>
        <File>Binaries/Win64/Civ6DllLoader.runtime.dll</File>
        <File>Binaries/Win64/Plugins/GameCore/NewRequirements.dll</File>
        <File>Data/Config.sql</File>
        <File>Data/Requirements.sql</File>
    </Files>
</Mod>
